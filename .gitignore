# Secrets. There is no committed .env template: local development uses .dev.vars, and the
# single source of truth for CI is GitHub Secrets.
.env
.env.*
.dev.vars
# the credential the build persists between runs — carries provider credentials, never commit
.cred/
dist/
work/
data/
resources/
.wrangler/
node_modules/
epg.xml
tuliprox
tuliprox.tar.gz
tuliprox.sha256
*.log
__pycache__/
*.pyc
